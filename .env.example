# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Use this once your domain is verified in Resend
RESEND_FROM_EMAIL=Disegno <disegnoproducts@gmail.com>

# Your inbox that should receive new orders
ORDER_EMAIL_TO=you@example.com,saboor@gmail.com

# Cloudflare Turnstile (required for contact messages and all checkout flows)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames, without schemes or paths. Also configure these in Cloudflare.
TURNSTILE_ALLOWED_HOSTNAMES=disegnoproducts.com,www.disegnoproducts.com
